pipeline {
    agent { label 'nodejsbuild' } 

    parameters {
        string(defaultValue: 'samplebucketfortesting12345', description: 'Bucket to Store Buildfiles', name: 'bucket')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('BuildImage') {
            steps {
                sh "cd simpleGoserver/ui && npm install && npm run build"
                sh "zip build.zip ./simpleGoserver/ui/build/"
                sh "aws s3 cp build.zip s3://${params.bucket}/postsapp/buildfiles/"
            }
        }

    }
}